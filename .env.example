# Copy this file to `.env` and fill in your values.
# `.env` is git-ignored. The values below are read by the app in DEBUG builds
# only (e.g. when running via `swift run Muxy`).

# Sentry DSN. Leave empty to disable Sentry locally.
# Find yours at https://sentry.io/settings/<org>/projects/<project>/keys/
SENTRY_DSN=

# PostHog project API key. Leave empty to disable anonymous usage analytics locally.
# Find yours at https://us.posthog.com/project/settings#project-api-key
POSTHOG_API_KEY=

# PostHog host. Optional; defaults to https://us.i.posthog.com.
# Set this when using EU cloud or a self-hosted instance.
POSTHOG_HOST=
